{
  "manifest_version": 3,
  "name": "PixelSquad",
  "version": "0.5.1.4",
  "description": "Ferramentas de construção, Wired, Enables e Handitems para Habblet. Criado por Pricilao.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.habblet.city/*",
    "https://*.habblet.city/*",
    "https://www.toolsblet.in/*",
    "https://toolsblet.in/*"
  ],
  "key": "",
  "update_url": "https://raw.githubusercontent.com/Pricilaoo/PixelSquad/main/updates/update.xml",
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PixelSquad",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "locales.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.toolsblet.in/enables*",
        "https://toolsblet.in/enables*"
      ],
      "js": [
        "toolsblet-importer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
