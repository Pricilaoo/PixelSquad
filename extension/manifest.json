{
  "manifest_version": 3,
  "name": "PixelSquad",
  "version": "0.5.0",
  "description": "Ferramentas de construção, Wired, Enables e Handitems para Habblet. Criado por Pricilao.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.habblet.city/*",
    "https://*.habblet.city/*",
    "https://www.toolsblet.in/*",
    "https://toolsblet.in/*"
  ],
  "action": {
    "default_title": "PixelSquad",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "locales.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.toolsblet.in/enables*",
        "https://toolsblet.in/enables*"
      ],
      "js": [
        "toolsblet-importer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}