{
  "manifest_version": 3,
  "name": "PixelSquad",
  "version": "0.5.3.19",
  "description": "Painel unificado de construção, Wired, visuais, chat, tradução, Enables e Handitems para Habblet. Criado por Pricilao.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.habblet.city/*",
    "https://*.habblet.city/*",
    "https://www.toolsblet.in/*",
    "https://toolsblet.in/*",
    "https://translate.googleapis.com/*"
  ],
  "key": "",
  "update_url": "https://raw.githubusercontent.com/Pricilaoo/PixelSquad/main/updates/update.xml",
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PixelSquad",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "game-context.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "anti-flood-config.js",
        "anti-flood-bridge.js",
        "builder-projects.js",
        "builder-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "anti-flood-config.js",
        "anti-flood.js"
      ],
      "css": [
        "anti-flood.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "command-suggestions.js"
      ],
      "css": [
        "command-suggestions.css"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "loading.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "css": [
        "tool-panels.css"
      ]
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "rgb.js"
      ],
      "css": [
        "rgb.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "locales.js",
        "translation.js",
        "avatar-generator.js",
        "launcher.js",
        "effects-catalog.js",
        "handitems-catalog.js",
        "builder-projects.js",
        "builder-panel.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "panel-controls.css",
        "avatar-generator.css",
        "builder-panel.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "main-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.toolsblet.in/enables*",
        "https://toolsblet.in/enables*"
      ],
      "js": [
        "toolsblet-importer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.toolsblet.in/handitems*",
        "https://toolsblet.in/handitems*"
      ],
      "js": [
        "toolsblet-importer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "music-player.js"
      ],
      "css": [
        "music-player.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "performance-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "performance-hud.js"
      ],
      "css": [
        "performance-hud.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "avatar-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ],
      "js": [
        "pixel-shortcut.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png",
        "icons/pixelsquad-loading.gif",
        "icons/pixelsquad-loading.png"
      ],
      "matches": [
        "https://www.habblet.city/*",
        "https://*.habblet.city/*"
      ]
    }
  ]
}
